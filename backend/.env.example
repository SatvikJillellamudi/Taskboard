# Copy this file to .env and fill in real values. Never commit .env.

# Local dev uses SQLite automatically. For Postgres:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/taskboard

# Generate a strong secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=paste-a-long-random-value-here

ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173
